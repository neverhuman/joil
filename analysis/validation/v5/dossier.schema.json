{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage", "first_seen_utc", "subject_sha256", "variant_id", "evidence", "controls", "interventions", "human_decisions", "classification", "industrial_installation_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "lineage": {"type": "array", "minItems": 1},
    "first_seen_utc": {"type": "string", "format": "date-time"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variant_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array"},
    "controls": {"type": "array"},
    "interventions": {"type": "array"},
    "human_decisions": {"type": "array"},
    "classification": {"const": "private"},
    "industrial_installation_authorized": {"const": false}
  }
}
