    "reproducer_stdin_python": "import hashlib,json\nfrom pathlib import Path\n\ndef digest(path):\n h=hashlib.sha256();size=0\n with Path(path).open(\"rb\") as f:\n  for block in iter(lambda:f.read(1024*1024),b\"\"):\n   h.update(block);size+=len(block)\n return h.hexdigest(),size\n\ndef verify_capture(root):\n root=Path(root)\n manifest_path=root/\"manifest.json\"\n checksum,_=digest(manifest_path)\n assert (root/\"manifest.sha256\").read_text().split()[0]==checksum,\"manifest SHA mismatch\"\n manifest=json.loads(manifest_path.read_text())\n names=[]\n for entry in manifest[\"files\"]:\n  rel=Path(entry[\"path\"])\n  assert not rel.is_absolute() and \"..\" not in rel.parts,\"unsafe raw path\"\n  path=root/rel\n  assert not path.is_symlink() and path.resolve().is_relative_to(root.resolve()),\"raw source escapes root\"\n  assert digest(path)==(entry[\"sha256\"],entry[\"bytes\"]),\"raw artifact differs: \"+str(rel)\n  names.append(rel.as_posix())\n assert len(names)==len(set(names)),\"duplicate inventory paths\"\n actual={p.relative_to(root).as_posix() for p in root.rglob(\"*\") if p.is_file()}\n assert actual==set(names)|{\"manifest.json\",\"manifest.sha256\"},\"unmanifested/missing raw artifacts\"\n proposals=mc_rows=seed_files=0\n for path in sorted(root.glob(\"wave4-proof-raw-*.jsonl\")):\n  projection=json.loads(path.with_suffix(\".json\").read_text())\n  generations=[];pending=[];reference=None\n  with path.open() as stream:\n   for line in stream:\n    event=json.loads(line)\n    if event[\"event\"]==\"seed_reference\":\n     assert reference is None,\"duplicate seed reference\"\n     reference=event[\"individual\"]\n     assert projection[\"reference\"]==reference\n     assert projection[\"arm\"]==event[\"arm\"] and projection[\"seed\"]==event[\"seed\"]\n     assert projection[\"config\"]==event[\"config\"]==manifest[\"config\"]\n     for key in [\"campaign_id\",\"source_commit\",\"objective_sha256\"]:\n      assert projection[key]==event[\"identity\"][key]==manifest[\"identity\"][key]\n     assert len(event[\"mc_observations\"])==manifest[\"config\"][\"mc_samples\"]\n     mc_rows+=len(event[\"mc_observations\"])\n    elif event[\"event\"]==\"proposal\":\n     pending.append(event[\"proposal\"]);proposals+=1\n     samples=event[\"mc_observations\"]\n     expected=0 if event[\"proposal\"][\"individual\"] is None else manifest[\"config\"][\"mc_samples\"]\n     assert len(samples)==expected,\"MC row count differs from actual evaluation\"\n     mc_rows+=len(samples)\n    elif event[\"event\"]==\"survival\":\n     generations.append({k:event[k] for k in [\"generation\",\"active_ids\",\"pareto_hypervolume\"]}|{\"proposals\":pending})\n     pending=[]\n    else:\n     raise AssertionError(\"unknown seed event \"+event[\"event\"])\n  assert reference is not None and not pending\n  assert projection[\"generation_populations\"]==generations,\"JSON projection diverges from raw JSONL events\"\n  seed_files+=1\n holdout=json.loads((root/\"wave4-proof-raw-holdouts.json\").read_text())\n folds=[];subjects={}\n with (root/\"holdouts.jsonl\").open() as stream:\n  for line in stream:\n   event=json.loads(line)\n   if event[\"event\"]==\"fold\":folds.append(event[\"fold\"])\n   elif event[\"event\"]==\"fold_subject\":\n    assert event[\"subject_id\"] not in subjects,\"duplicate fold alias\"\n    subjects[event[\"subject_id\"]]=event[\"original_candidate\"]\n   else:raise AssertionError(\"unknown holdout event\")\n assert folds==holdout[\"folds\"],\"fold projection diverges from raw JSONL\"\n for fold in folds:\n  for name in fold[\"train_subject_ids\"]:assert name in subjects\n  for p in fold[\"predictions\"]:\n   assert p[\"subject_id\"] in subjects\n   assert p[\"target_cout\"]==subjects[p[\"subject_id\"]][\"mc_robustness\"][\"cout_sample_screen_upper_mg_l\"]\n ref_events=[json.loads(line) for line in (root/\"reference-baseline-ct35-b0.jsonl\").read_text().splitlines()]\n assert len(ref_events)==1\n assert ref_events[0][\"individual\"]==json.loads((root/\"wave4-proof-raw-reference.json\").read_text())[\"candidate\"]\n return {\"passed\":True,\"manifest_sha256\":checksum,\"files\":len(names),\"seed_streams\":seed_files,\"charged_proposal_events\":proposals,\"raw_MC_rows_in_seed_streams\":mc_rows,\"folds\":len(folds),\"fold_subjects\":len(subjects),\"identity\":manifest[\"identity\"],\"config\":manifest[\"config\"]}\n\nif __name__==\"__main__\":\n import sys\n print(json.dumps(verify_capture(sys.argv[1]),indent=2))\n",
